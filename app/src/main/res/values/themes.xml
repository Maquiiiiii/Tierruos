<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThemeOverlay.Tierruos.CreatePack" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Tierruos</item>
        <item name="colorSurface">@color/surface_dialog</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Tierruos.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Tierruos.Button.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Tierruos.Button.Secondary</item>
    </style>

    <style name="MaterialAlertDialog.Tierruos" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearance">@style/ShapeAppearance.Tierruos.Dialog</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Tierruos.Dialog</item>
        <item name="backgroundTint">@color/surface_dialog</item>
    </style>

    <style name="Theme.Tierruos" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorSecondary">@color/accent_primary</item>
        <item name="colorSecondaryVariant">@color/accent_primary</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/bg_canvas</item>
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="android:colorBackground">@color/bg_canvas</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:navigationBarColor">@color/bg_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.Tierruos.Title</item>
        <item name="textAppearanceHeadline1">@style/TextAppearance.Tierruos.Title</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.Tierruos.Title</item>
        <item name="textAppearanceHeadline3">@style/TextAppearance.Tierruos.Title</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.Tierruos.Title</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.Tierruos.Title</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Tierruos.Body</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Tierruos.Body</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Tierruos.Body</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Tierruos.Body</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Tierruos.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.Tierruos.Body</item>
        <item name="textAppearanceOverline">@style/TextAppearance.Tierruos.Caption</item>
        <item name="android:textAppearance">@style/TextAppearance.Tierruos.Body</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.Tierruos.Title</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Tierruos.Body</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.Tierruos.Caption</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Tierruos.Card</item>
        <item name="materialCardViewStyle">@style/Widget.Tierruos.Card</item>
        <item name="materialButtonStyle">@style/Widget.Tierruos.Button.Secondary</item>
    </style>

    <style name="TextAppearance.Tierruos.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:breakStrategy">balanced</item>
        <item name="android:hyphenationFrequency">none</item>
    </style>

    <style name="TextAppearance.Tierruos.CardTitle" parent="TextAppearance.Tierruos.Title">
        <item name="android:textSize">@dimen/text_card_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Tierruos.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Tierruos.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Tierruos.Counter" parent="TextAppearance.Tierruos.Caption">
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.Tierruos.TechnicalMetric" parent="TextAppearance.Tierruos.Counter">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Tierruos.FileSize" parent="TextAppearance.Tierruos.TechnicalMetric" />

    <style name="Widget.Tierruos.Title" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Tierruos.Title</item>
        <item name="android:breakStrategy">balanced</item>
        <item name="android:hyphenationFrequency">none</item>
    </style>

    <style name="ShapeAppearance.Tierruos.Card" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="ShapeAppearance.Tierruos.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dialog_corner_radius</item>
    </style>

    <style name="ShapeAppearance.Tierruos.CardContent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card_content</item>
    </style>

    <style name="Widget.Tierruos.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="cardMaxElevation">@dimen/elevation_none</item>
        <item name="strokeWidth">@dimen/stroke_precision</item>
        <item name="strokeColor">@color/border_card</item>
    </style>

    <style name="Widget.Tierruos.CanvasCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/canvas_corner_radius</item>
        <item name="contentPadding">@dimen/elevation_none</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="cardMaxElevation">@dimen/elevation_none</item>
        <item name="strokeWidth">@dimen/stroke_accent</item>
        <item name="strokeColor">@color/border_navbar_outer</item>
    </style>

    <style name="Widget.Tierruos.Tool" parent="Widget.AppCompat.ImageButton">
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:padding">@dimen/space_12</item>
        <item name="android:background">@drawable/bg_tool_button</item>
    </style>

    <style name="Widget.Tierruos.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textAppearance">@style/TextAppearance.Tierruos.Body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_primary_foreground</item>
        <item name="backgroundTint">@color/button_primary_background</item>
        <item name="iconTint">@color/button_primary_foreground</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconPadding">@dimen/space_8</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:elevation">@dimen/elevation_none</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">@dimen/elevation_none</item>
        <item name="android:insetBottom">@dimen/elevation_none</item>
    </style>

    <style name="Widget.Tierruos.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="iconGravity">textStart</item>
        <item name="android:textAppearance">@style/TextAppearance.Tierruos.Body</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/surface_elevated</item>
        <item name="strokeColor">@color/border_elevated</item>
        <item name="strokeWidth">@dimen/stroke_precision</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconPadding">@dimen/space_8</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:elevation">@dimen/elevation_none</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">@dimen/elevation_none</item>
        <item name="android:insetBottom">@dimen/elevation_none</item>
    </style>
</resources>
