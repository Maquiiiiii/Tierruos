<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_input" />
            <corners android:radius="@dimen/input_corner_radius" />
            <stroke
                android:width="@dimen/stroke_accent"
                android:color="@color/accent_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_input" />
            <corners android:radius="@dimen/input_corner_radius" />
            <stroke
                android:width="@dimen/stroke_precision"
                android:color="@color/border_elevated" />
        </shape>
    </item>
</selector>
