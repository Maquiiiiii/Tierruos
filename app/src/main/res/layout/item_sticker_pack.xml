<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingStart="@dimen/space_16" android:paddingEnd="@dimen/space_16" android:paddingBottom="@dimen/space_16">
    <com.google.android.material.card.MaterialCardView android:id="@+id/packCard" style="@style/Widget.Tierruos.Card"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true"
        app:cardPreventCornerOverlap="false" app:cardUseCompatPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/packName" style="@style/Widget.Tierruos.Title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_margin="@dimen/space_8" />
            <TextView android:id="@+id/publisher" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8" android:layout_marginEnd="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.Tierruos.Caption" />
            <GridLayout android:id="@+id/stickerGrid" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16" android:columnCount="3" android:alignmentMode="alignMargins" />
            <TextView android:id="@+id/packProgress" style="@style/Widget.Tierruos.Title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_margin="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.Tierruos.Counter" android:fontFeatureSettings="tnum" />
            <LinearLayout android:id="@+id/packActions" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:visibility="gone">
                <com.google.android.material.button.MaterialButton android:id="@+id/newSticker" style="@style/Widget.Tierruos.Button.Secondary"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="@string/new_sticker" app:icon="@drawable/ic_create" />
                <com.google.android.material.button.MaterialButton android:id="@+id/deletePack" style="@style/Widget.Tierruos.Button.Secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/delete_pack" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
