<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_updater"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_16"
        android:background="@drawable/bg_pack_progress" />

    <!-- Header -->
    <TextView
        android:id="@+id/updaterTitle"
        style="@style/Widget.Tierruos.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/updater_title"
        android:textAppearance="@style/TextAppearance.Tierruos.Title"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/updaterCurrentVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.Tierruos.Counter"
        android:textColor="@color/text_secondary" />

    <!-- State 1: Checking -->
    <LinearLayout
        android:id="@+id/stateChecking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:text="@string/updater_checking"
            android:textAppearance="@style/TextAppearance.Tierruos.Body"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- State 2 & 3: Concise Status / Version Summary (no README or release notes) -->
    <LinearLayout
        android:id="@+id/stateResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_detail_sticker_slot"
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:visibility="gone">

        <TextView
            android:id="@+id/updaterStatusHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Tierruos.CardTitle"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/updaterVersionDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Tierruos.Caption"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- State 4: Live Download Progress inside the same window -->
    <LinearLayout
        android:id="@+id/stateDownloading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_detail_sticker_slot"
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:visibility="gone">

        <TextView
            android:id="@+id/downloadingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/updater_downloading"
            android:textAppearance="@style/TextAppearance.Tierruos.Body"
            android:textColor="@color/text_primary" />

        <ProgressBar
            android:id="@+id/downloadProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/space_10"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_pack_progress" />

        <TextView
            android:id="@+id/downloadProgressMetric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:fontFamily="monospace"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Tierruos.TechnicalMetric"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/updateNowButton"
            style="@style/Widget.Tierruos.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="@dimen/space_8"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/updater_download_cta"
            android:visibility="gone"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeUpdaterButton"
            style="@style/Widget.Tierruos.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/updater_close"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
