<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_16"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_8">

    <EditText
        android:id="@+id/caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:background="@drawable/bg_dialog_input"
        android:hint="@string/text_layer_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="160"
        android:maxLines="4"
        android:minHeight="@dimen/touch_target_min"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_12"
        android:textAppearance="@style/TextAppearance.Tierruos.Body"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary" />
</LinearLayout>
