<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:id="@+id/dialogTitle"
            style="@style/Widget.Tierruos.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_layer_title"
            android:textAppearance="@style/TextAppearance.Tierruos.Title"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:autofillHints=""
            android:background="@drawable/bg_dialog_input"
            android:hint="@string/text_layer_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="160"
            android:maxLines="4"
            android:minHeight="@dimen/touch_target_min"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_12"
            android:textAppearance="@style/TextAppearance.Tierruos.Body"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <com.tierruos.stickers.ui.AdaptiveDialogActionsLayout
            android:id="@+id/dialogActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelButton"
                style="@style/Widget.Tierruos.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:paddingStart="@dimen/space_20"
                android:paddingEnd="@dimen/space_20"
                android:text="@string/cancel_action"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmButton"
                style="@style/Widget.Tierruos.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:paddingStart="@dimen/space_20"
                android:paddingEnd="@dimen/space_20"
                android:text="@string/apply_action"
                app:cornerRadius="14dp" />
        </com.tierruos.stickers.ui.AdaptiveDialogActionsLayout>
    </LinearLayout>
</ScrollView>
