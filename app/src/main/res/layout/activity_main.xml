<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ListView android:id="@+id/packList" android:layout_width="match_parent" android:layout_height="match_parent"
        android:paddingTop="@dimen/library_content_top" android:paddingBottom="@dimen/library_content_bottom"
        android:clipToPadding="false" android:divider="@null" android:dividerHeight="@dimen/elevation_none"
        android:listSelector="@android:color/transparent" android:scrollbars="vertical" />
    <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical" android:padding="@dimen/space_24" android:visibility="gone">
        <TextView style="@style/Widget.Tierruos.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/empty_library_title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8"
            android:textAppearance="@style/TextAppearance.Tierruos.Body" android:textColor="@color/text_secondary" android:text="@string/empty_library_body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/emptyChoose" style="@style/Widget.Tierruos.Button.Secondary"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16"
            android:text="@string/choose_image" app:icon="@drawable/ic_create" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top"
        android:background="@color/background" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="@dimen/space_16" android:paddingEnd="@dimen/space_16">
        <TextView android:id="@+id/appTitle" style="@style/Widget.Tierruos.Title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/app_name" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pasteImage" style="@style/Widget.Tierruos.Button.Secondary"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/paste_image"
            android:visibility="gone" />
        <ImageButton android:id="@+id/createPack" style="@style/Widget.Tierruos.Tool" android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min" android:contentDescription="@string/new_pack" android:src="@drawable/ic_create" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/exportButton" style="@style/Widget.Tierruos.Button.Primary"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:layout_margin="@dimen/space_16" android:text="@string/add_whatsapp" app:icon="@drawable/ic_export" app:iconGravity="textStart" />
    <LinearLayout android:id="@+id/loadError" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:padding="@dimen/space_24" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/operation_failed"
            android:textColor="@color/error" android:textAppearance="@style/TextAppearance.Tierruos.Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/retryButton" style="@style/Widget.Tierruos.Button.Secondary"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/retry_action" />
    </LinearLayout>
    <include android:id="@+id/loading" layout="@layout/view_busy_overlay" />
</FrameLayout>
