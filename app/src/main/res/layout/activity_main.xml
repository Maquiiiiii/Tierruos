<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas">

    <!-- Pack list with clipToPadding=false and paddingBottom=116dp so cards scroll above the floating navbar -->
    <ListView
        android:id="@+id/packList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="@dimen/elevation_none"
        android:listSelector="@android:color/transparent"
        android:paddingTop="@dimen/library_content_top"
        android:paddingBottom="@dimen/library_content_bottom"
        android:scrollbars="vertical" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/space_20"
        android:layout_marginEnd="@dimen/space_20"
        android:layout_marginBottom="@dimen/space_32"
        android:background="@drawable/bg_card_bento"
        android:orientation="vertical"
        android:padding="@dimen/space_24"
        android:visibility="gone">

        <TextView
            style="@style/Widget.Tierruos.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/empty_library_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/empty_library_body"
            android:textAppearance="@style/TextAppearance.Tierruos.Body"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emptyChoose"
            style="@style/Widget.Tierruos.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/choose_image"
            app:icon="@drawable/ic_create" />
    </LinearLayout>

    <!-- Top header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/bg_canvas"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_8">

        <TextView
            android:id="@+id/appTitle"
            style="@style/Widget.Tierruos.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:text="@string/app_name" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pasteImage"
            style="@style/Widget.Tierruos.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            android:text="@string/paste_image"
            android:visibility="gone"
            app:icon="@drawable/ic_paste"
            app:iconGravity="textStart" />

        <ImageButton
            android:id="@+id/createPack"
            style="@style/Widget.Tierruos.Tool"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/new_pack"
            android:src="@drawable/ic_create"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Bottom floating dock: High-Contrast Animated Bottom Navbar only -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <com.tierruos.stickers.ui.AnimatedBottomNav
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/navbar_height"
            android:layout_marginStart="@dimen/navbar_margin_horizontal"
            android:layout_marginEnd="@dimen/navbar_margin_horizontal"
            android:layout_marginBottom="@dimen/navbar_margin_bottom" />
    </LinearLayout>

    <!-- Load error state -->
    <LinearLayout
        android:id="@+id/loadError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_24"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/operation_failed"
            android:textAppearance="@style/TextAppearance.Tierruos.Body"
            android:textColor="@color/error" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            style="@style/Widget.Tierruos.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/retry_action" />
    </LinearLayout>

    <include
        android:id="@+id/loading"
        layout="@layout/view_busy_overlay" />
</FrameLayout>
