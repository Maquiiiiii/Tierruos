<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_24">
        <TextView style="@style/Widget.Tierruos.Title" android:id="@+id/previewTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/design_preview_title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8" android:textAppearance="@style/TextAppearance.Tierruos.Body"
            android:text="@string/design_preview_body" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Tierruos.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24" app:cardPreventCornerOverlap="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageButton style="@style/Widget.Tierruos.Tool" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="@dimen/touch_target_min" android:src="@drawable/ic_create" android:contentDescription="@string/design_preview_create" />
                    <ImageButton style="@style/Widget.Tierruos.Tool" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="@dimen/touch_target_min" android:src="@drawable/ic_paste" android:contentDescription="@string/design_preview_paste" />
                    <ImageButton style="@style/Widget.Tierruos.Tool" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="@dimen/touch_target_min" android:src="@drawable/ic_lasso" android:contentDescription="@string/design_preview_lasso" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8" android:orientation="horizontal">
                    <ImageButton style="@style/Widget.Tierruos.Tool" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="@dimen/touch_target_min" android:src="@drawable/ic_eraser" android:contentDescription="@string/design_preview_eraser" />
                    <ImageButton style="@style/Widget.Tierruos.Tool" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="@dimen/touch_target_min" android:src="@drawable/ic_transform" android:contentDescription="@string/design_preview_transform" />
                    <ImageButton style="@style/Widget.Tierruos.Tool" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="@dimen/touch_target_min" android:src="@drawable/ic_text" android:contentDescription="@string/design_preview_text" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8" android:orientation="horizontal">
                    <ImageButton style="@style/Widget.Tierruos.Tool" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="@dimen/touch_target_min" android:src="@drawable/ic_outline" android:contentDescription="@string/design_preview_outline" />
                    <ImageButton style="@style/Widget.Tierruos.Tool" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="@dimen/touch_target_min" android:src="@drawable/ic_undo" android:contentDescription="@string/design_preview_undo" />
                    <ImageButton style="@style/Widget.Tierruos.Tool" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="@dimen/touch_target_min" android:src="@drawable/ic_export" android:contentDescription="@string/design_preview_export" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="@dimen/space_16">
            <TextView android:id="@+id/previewCounter" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Tierruos.Counter"
                android:text="@string/design_preview_counter" />
            <TextView android:id="@+id/previewMetric" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Tierruos.TechnicalMetric" android:text="@string/design_preview_metric" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24" android:textAppearance="@style/TextAppearance.Tierruos.Body"
            android:textColor="@color/error" android:text="@string/design_preview_error" />
        <ProgressBar android:id="@+id/previewLoading" style="?android:attr/progressBarStyleSmall"
            android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size"
            android:layout_marginTop="@dimen/space_16" android:indeterminateTint="@color/accent"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/previewPrimary"
            style="@style/Widget.Tierruos.Button.Primary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24"
            android:text="@string/design_preview_primary" app:icon="@drawable/ic_export" app:iconGravity="textStart" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Tierruos.Button.Secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8" android:text="@string/design_preview_secondary" />
    </LinearLayout>
</ScrollView>
